+    def test_host_exception_stays_on_its_thread(self):
+        # As in the core API: an exception a host function raised is held
+        # for the call that ran it, and a trap on another thread must not
+        # raise it.
+        engine = Engine()
+        store = Store(engine)
+        component = Component(engine, """
+            (component
+                (core module $a (func (export "a") unreachable))
+                (core instance $a (instantiate $a))
+                (func (export "a") (canon lift (core func $a "a")))
+            )
+        """)
+        a = Linker(engine).instantiate(store, component).get_func(store, 'a')
+        assert(a is not None)
+        held = threading.Event()
+        trapped = threading.Event()
+        raised = []
+
+        def other_thread():
+            try:
+                _enter.LAST_EXCEPTION.exn = ValueError("from the other thread")
+            finally:
+                held.set()
+            trapped.wait()
+            try:
+                _enter.maybe_raise_last_exn()
+            except ValueError as e:
+                raised.append(e)
+
+        t = threading.Thread(target=other_thread)
+        t.start()
+        held.wait()
+        try:
+            with self.assertRaises(WasmtimeError):
+                a(store)
+        finally:
