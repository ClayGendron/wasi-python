+    def test_host_exception_stays_on_its_thread(self):
+        # A host function's exception is held until the call into wasm that
+        # ran it returns. A trap on another thread in that window must raise
+        # its own `Trap`, and leave the exception to the thread that owns it.
+        store = Store()
+        module = Module(store.engine, '(module (func (export "run") unreachable))')
+        run = Instance(store, module, []).exports(store)["run"]
+        assert(isinstance(run, Func))
+        held = threading.Event()
+        trapped = threading.Event()
+        raised = []
+
+        def other_thread():
+            try:
+                _func.LAST_EXCEPTION.exn = ValueError("from the other thread")
+            finally:
+                held.set()
+            trapped.wait()
+            try:
+                _func.maybe_raise_last_exn()
+            except ValueError as e:
+                raised.append(e)
+
+        t = threading.Thread(target=other_thread)
+        t.start()
+        held.wait()
+        try:
+            with self.assertRaises(Trap):
+                run(store)
+        finally:
+            trapped.set()
+            t.join()
+        self.assertEqual(len(raised), 1)
