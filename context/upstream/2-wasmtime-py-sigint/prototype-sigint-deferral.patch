+    def test_sigint_at_host_function_entry(self):
+        # Python runs a SIGINT handler at the next bytecode boundary on the
+        # main thread. When that is the entry of a host function's callback,
+        # before any `try` in it, the `KeyboardInterrupt` must still reach the
+        # caller, and the process must not crash.
+        store = Store()
+        module = Module(store.engine, """
+            (module
+                (import "" "f" (func $f))
+                (memory (export "m") 1)
+                (func (export "run")
+                    (i32.store (i32.const 4) (i32.const 1))
+                    (loop $l (br_if $l (i32.eqz (i32.load (i32.const 0)))))
+                    call $f))
+        """)
+        func = Func(store, FuncType([], []), lambda: None)
+        exports = Instance(store, module, [func]).exports(store)
+        run = exports["run"]
+        memory = exports["m"]
+        assert(isinstance(run, Func))
+        assert(isinstance(memory, Memory))
+        data = memory.data_ptr(store)
+
+        def interrupt():
+            while data[4] == 0:  # until the guest is in its loop
+                time.sleep(0.001)
+            signal.raise_signal(signal.SIGINT)
+            data[0] = 1  # then let it leave the loop and call `f`
+
+        previous = signal.signal(signal.SIGINT, signal.default_int_handler)
+        thread = threading.Thread(target=interrupt)
+        try:
+            thread.start()
+            with self.assertRaises(KeyboardInterrupt):
+                run(store)
+            self.assertIs(signal.getsignal(signal.SIGINT), signal.default_int_handler)
+            data[0] = 0
+            data[4] = 0
+            # The next call works.
+            data[0] = 1
+            run(store)
+        finally:
+            thread.join()
+            signal.signal(signal.SIGINT, previous)
+
