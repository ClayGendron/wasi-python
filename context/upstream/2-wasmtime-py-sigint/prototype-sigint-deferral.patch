+
+# Ctrl-C while the main thread is in wasm.
+#
+# Python runs a signal handler at the next bytecode boundary on the main
+# thread. If that is the entry of a host function's ctypes callback, before
+# its `try`, the `KeyboardInterrupt` escapes the callback. ctypes then prints
+# it as unraisable and returns to Wasmtime without writing the return value,
+# so Wasmtime reads a stale value as a `wasm_trap_t *` and the process
+# crashes. No code inside the callback can catch an exception raised at its
+# own entry.
+#
+# So while the main thread is in wasm, and only if SIGINT has Python's default
+# handler, a handler that only records the signal takes its place. Host
+# functions raise the recorded `KeyboardInterrupt` inside their `try`, where
+# it becomes a trap, and the call raises it when it returns.
+_sigint_pending = False
+
+
+def _record_sigint(signum: int, frame: Any) -> None:
+    global _sigint_pending
+    _sigint_pending = True
+
+
+def raise_deferred_sigint() -> None:
+    global _sigint_pending
+    if _sigint_pending:
+        _sigint_pending = False
+        raise KeyboardInterrupt
+
+
+@contextmanager
+def defer_sigint() -> Iterator[None]:
+    if threading.current_thread() is not threading.main_thread() or \
+            signal.getsignal(signal.SIGINT) is not signal.default_int_handler:
+        # Another thread, a nested call, or the embedder's own handler.
+        yield
+        return
+    signal.signal(signal.SIGINT, _record_sigint)
+    try:
+        yield
+    finally:
+        if signal.getsignal(signal.SIGINT) is _record_sigint:
+            signal.signal(signal.SIGINT, signal.default_int_handler)
+        raise_deferred_sigint()
 
 
