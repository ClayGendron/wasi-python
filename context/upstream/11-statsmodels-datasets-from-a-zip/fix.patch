+def open_data_file(base_file, file_name):
+    """
+    Open a data file that ships beside a dataset module
+
+    Parameters
+    ----------
+    base_file : str
+        The path of the file requesting the data, typically ``__file__``.
+        The data file is assumed to live in the same directory.
+    file_name : str
+        The name of the data file to open.
+
+    Returns
+    -------
+    file
+        The data file, opened for reading in binary mode.
+
+    Notes
+    -----
+    When statsmodels is imported from a zip archive, ``base_file`` names a
+    path inside the archive, which is not a directory on disk. The file is
+    then read as a package resource with ``importlib.resources``.
+    """
+    filename = Path(base_file).resolve().parent / file_name
+    if filename.is_file():
+        return filename.open("rb")
+    from importlib.resources import files
+
+    package_dir = Path(base_file).parent.relative_to(Path(__file__).parent)
+    package = ".".join(("statsmodels", "datasets", *package_dir.parts))
+    return files(package).joinpath(file_name).open("rb")
+
