diff --git a/scripts/line.py b/scripts/line.py
index 456767e..59fdd95 100644
--- a/scripts/line.py
+++ b/scripts/line.py
@@ -6,11 +6,19 @@ safe for the shell to source). `PYTHON_MM` and `PYTHON_TAG` are derived from `PY
 `steps/common.sh` derives them, so they cannot disagree with it.
 """
 
+import platform
 import re
 from pathlib import Path
 
 CONF = Path(__file__).resolve().with_name("line.conf")
 LINE = re.compile(r"([A-Z][A-Z0-9_]*)=([A-Za-z0-9._+-]+)")
+HOSTS = {
+    ("Darwin", "arm64"): "MACOS_ARM64",
+    ("Linux", "aarch64"): "LINUX_AARCH64",
+    ("Linux", "arm64"): "LINUX_AARCH64",
+    ("Linux", "x86_64"): "LINUX_X86_64",
+}
+HOST_NAMES = ("WASI_SDK_DIR", "WASMTIME_DIR", "HOST_PYTHON_ARCHIVE", "CYTHON_WHEEL", "NINJA_WHEEL")
 
 
 def read(path: Path = CONF) -> dict[str, str]:
@@ -23,6 +31,13 @@ def read(path: Path = CONF) -> dict[str, str]:
         if match is None:
             raise SystemExit(f"{path.name}:{number}: not NAME=value: {text!r}")
         values[match[1]] = match[2]
+    key = HOSTS.get((platform.system(), platform.machine()))
+    if key is None:
+        raise SystemExit(f"no line for host {platform.system()}-{platform.machine()}")
+    for name in HOST_NAMES:
+        if f"{key}_{name}" not in values:
+            raise SystemExit(f"{path.name} has no {key}_{name}")
+        values[name] = values[f"{key}_{name}"]
     major, minor, _ = values["PYTHON_VERSION"].split(".")
     values["PYTHON_MM"] = f"{major}.{minor}"
     values["PYTHON_TAG"] = f"{major}{minor}"
diff --git a/scripts/line.sh b/scripts/line.sh
index 02adfda..8b3637e 100644
--- a/scripts/line.sh
+++ b/scripts/line.sh
@@ -6,5 +6,16 @@ if grep -v -E '^(#.*|[A-Z][A-Z0-9_]*=[A-Za-z0-9._+-]+)$' "$LINE_CONF" > /dev/nul
   exit 1
 fi
 . "$LINE_CONF"
+case "$(uname -s)-$(uname -m)" in
+  Darwin-arm64) HOST_KEY=MACOS_ARM64;;
+  Linux-aarch64|Linux-arm64) HOST_KEY=LINUX_AARCH64;;
+  Linux-x86_64) HOST_KEY=LINUX_X86_64;;
+  *) echo "ERROR: no line for host $(uname -s)-$(uname -m)" >&2; exit 1;;
+esac
+for name in WASI_SDK_DIR WASMTIME_DIR HOST_PYTHON_ARCHIVE CYTHON_WHEEL NINJA_WHEEL; do
+  eval "value=\${${HOST_KEY}_$name:-}"
+  [ -n "$value" ] || { echo "ERROR: scripts/line.conf has no ${HOST_KEY}_$name" >&2; exit 1; }
+  eval "$name=\$value"
+done
 PYTHON_MM=${PYTHON_VERSION%.*}
 PYTHON_TAG=$(printf '%s' "$PYTHON_MM" | tr -d .)
