# probe_var.py: 60 runs each; 'main' is main's driver, 'times' the times-only prototype, 'both' the prototype (times and inode numbers)
## program: import os, time;open('/f', 'w').write('x');print(time.localtime(os.stat('/f').st_mtime).tm_year);
main  main 16255056 {0: 4, 17: 56}
times 16255107 {0: 3, 17: 57}
both  16254698 {0: 60}
## program: import os;open('/f', 'w').write('x');os.stat('/f');
main  main 16062213 {0: 6, 17: 54}
times 16062213 {0: 2, 17: 58}
both  16061813 {0: 60}
## program: import os;open('/f', 'w').write('x');x = str(os.stat('/f').st_ino);
