            assert r.exit_code == 0, (case, r.describe())
            out = r.root / "out.txt"
            kept = out.stat().st_size if out.exists() else 0
            if kept != 100:
                findings.append(f"{which}: {FROZEN_HEAP_FINDING[case]} kept {kept} of 100 bytes")
