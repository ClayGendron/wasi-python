+    pub fn assert_secure(&self) {
+        assert!(
+            self.tempdir.path().join("outside/secret").exists(),
+            "`outside` was moved out of place"
+        );
+        assert!(
+            !self.tempdir.path().join("sandbox/stolen").exists(),
+            "`outside` was moved into the sandbox"
+        );
+    }
+}
