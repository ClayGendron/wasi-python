+    assert_not_directory(dir, "file/", "target");
+    assert_not_directory(dir, "file", "target/");
+    dir.stat_at(PathFlags::empty(), "file")
+        .expect("the file wasn't renamed");
+    dir.unlink_file_at("file").expect("removing a file");
