+/* RESEARCH ONLY (spec 071's research, not a recipe): the C-stack guard's window from the
+ * environment variable RESEARCH_C_STACK (bytes), applied at run(). Absent: CPython's own window. */
+extern unsigned char __stack_high;
+static void
+research_guard(void)
+{
+    size_t count = 0, size = 0;
+    if (__wasi_environ_sizes_get(&count, &size) != 0) {
+        return;
+    }
+    char **items = calloc(count + 1, sizeof(char *));
+    char *buf = malloc(size + 1);
+    if (items && buf && __wasi_environ_get((uint8_t **)items, (uint8_t *)buf) == 0) {
+        for (size_t i = 0; i < count; i++) {
+            if (strncmp(items[i], "RESEARCH_C_STACK=", 17) == 0) {
+                size_t n = strtoul(items[i] + 17, NULL, 10);
+                uintptr_t top = (uintptr_t)&__stack_high;
+                if (PyUnstable_ThreadState_SetStackProtection(PyThreadState_Get(), (void *)(top - n), n) < 0) {
+                    PyErr_Print();
+                    abort();
+                }
+            }
+        }
+    }
+    free(items);
+    free(buf);
+}
