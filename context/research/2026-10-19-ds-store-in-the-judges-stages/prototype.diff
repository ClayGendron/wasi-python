index 0000000..01c17d2
--- /dev/null
+++ b/tests/harness/litter.py
@@ -0,0 +1,186 @@
+"""Host litter: files a host process drops into a folder the guest sees (prototype, spec draft).
+
+macOS writes `.DS_Store` files into folders it sizes or shows (Finder, and System Settings'
+storage scan, through DesktopServices), as the user, at any time. A file that appears in a grant
+while a guest runs changes what the guest lists and the folder's times, and so its fuel. Two
+defences, neither of which ever hides a file from a check:
+
+- A read-only stage is sealed: every folder in it loses its write bits once it is staged, so no
+  process of the user's can add a file to it. It is unsealed only to be removed.
+- Every guest run is watched: each granted folder is scanned for litter before and after the run,
+  a read-only grant must hold exactly the same entries after the run as before, and any litter
+  name the guest is handed by `fd_readdir` voids the run. A voided run raises `HostLitter`, which
+  names the file; it is never filtered out, retried or ignored.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import stat
+import sys
+from collections.abc import Iterable
+from pathlib import Path
+
+from harness import paths
+
+# PROTOTYPE ONLY: P_LITTER=off (neither defence), watch (no seal), on (both; the default).
+MODE = os.environ.get("P_LITTER", "on")
+
+# What an operating system or its helpers leave in folders on their own (never a source file):
+# spec 018's OS_LITTER, widened by the spec draft (AppleDouble `._x` files are matched by prefix).
+LITTER_NAMES = frozenset(
+    {
+        *paths.OS_LITTER,  # .DS_Store, Thumbs.db, desktop.ini
+        ".Spotlight-V100",  # Spotlight's index, at a volume's root
+        ".fseventsd",  # the file system event log, at a volume's root
+        ".Trashes",
+        ".TemporaryItems",
+        ".DocumentRevisions-V100",
+        ".apdisk",
+        "Icon\r",  # a folder's custom icon
+        "ehthumbs.db",
+    }
+)
+
+
+def is_litter(name: str) -> bool:
+    """True for a name only an operating system leaves (AppleDouble `._x` files included)."""
+    return name in LITTER_NAMES or name.startswith("._")
+
+
+class HostLitter(AssertionError):
+    """A file no check put there appeared in a folder the guest sees: the run proves nothing."""
+
+
+def litter_in(root: Path) -> list[str]:
+    """Every litter entry under `root`, relative to it, sorted; symlinks are not followed."""
+    found: list[str] = []
+    for d, dirs, files in os.walk(root):
+        for name in (*dirs, *files):
+            if is_litter(name):
+                found.append(Path(d, name).relative_to(root).as_posix())
+    return sorted(found)
+
+
+def inventory(root: Path) -> frozenset[str]:
+    """Every entry under `root`, relative to it (a folder with a trailing slash)."""
+    out: set[str] = set()
+    for d, dirs, files in os.walk(root):
+        rel = Path(d).relative_to(root)
+        out |= {(rel / n).as_posix() + "/" for n in dirs}
+        out |= {(rel / n).as_posix() for n in files}
+    return frozenset(out)
+
+
+def _folders(root: Path) -> Iterable[str]:
+    for d, _dirs, _files in os.walk(root):
+        yield d
+
+
+def seal(root: Path) -> list[str]:
+    """Take the write bits off every folder under `root` (and `root`), so no process of this user
+    can add, remove or rename an entry in it. Then remove litter that landed while the stage was
+    being written (it was never staged, and no guest has run): each one's folder is opened for the
+    unlink alone, and the scan repeats until it finds none. Returns what was removed, for the
+    run's record. On Windows, where a folder's mode does not stop a write, nothing is sealed."""
+    if MODE != "on":
+        return []
+    _set_writable(root, False)
+    removed: list[str] = []
+    for _ in range(10):
+        found = litter_in(root)
+        if not found:
+            return removed
+        for rel in reversed(found):
+            p = root / rel
+            _set_writable(p.parent, True, deep=False)
+            try:
+                if p.is_dir() and not p.is_symlink():
+                    unseal(p)
+                    shutil.rmtree(p)
+                else:
+                    p.unlink()
+            finally:
+                _set_writable(p.parent, False, deep=False)
+        removed += found
+    raise HostLitter(_message([f"{rel} keeps coming back while sealing" for rel in found]))
+
+
+def _set_writable(root: Path, on: bool, *, deep: bool = True) -> None:
+    if sys.platform == "win32":
+        return
+    for d in _folders(root) if deep else (str(root),):
+        mode = stat.S_IMODE(os.lstat(d).st_mode)
+        bits = stat.S_IWUSR | stat.S_IWGRP | stat.S_IWOTH
+        os.chmod(d, mode | stat.S_IWUSR if on else mode & ~bits)
+
+
+def unseal(root: Path) -> None:
+    """Give every folder under `root` its owner's write bit back."""
+    if sys.platform == "win32" or not root.exists():
+        return
+    for d in _folders(root):
+        mode = stat.S_IMODE(os.lstat(d).st_mode)
+        os.chmod(d, mode | stat.S_IWUSR)
+
+
+def remove(root: Path) -> None:
+    """Unseal, then remove, a stage (a sealed folder cannot be emptied). A writer can refill a
+    folder between the unlink of its last entry and its own removal, as spec 018 found for the
+    build's `rm -rf`, so the removal is tried again, five times at most. What is still left then is
+    never read again: every stage has a fresh name."""
+    for _ in range(5):
+        try:
+            unseal(root)
+        except OSError:
+            pass
+        shutil.rmtree(root, ignore_errors=True)
+        if not root.exists():
+            return
+
+
+class Watch:
+    """One guest run's grants, looked at before and after the run.
+
+    `grants` are (host folder, guest path, writable). A read-only grant must list the same entries
+    after the run as before; no grant may hold litter before or after; and the guest must never
+    have been handed a litter name by `fd_readdir` (`seen`, filled by the driver)."""
+
+    def __init__(self, grants: Iterable[tuple[str, str, bool]]) -> None:
+        self.grants = [(Path(h), g, w) for h, g, w in grants] if MODE != "off" else []
+        self.before: dict[str, frozenset[str]] = {}
+        problems: list[str] = []
+        for host, guest, writable in self.grants:
+            problems += [f"{_join(guest, rel)} (before the run)" for rel in litter_in(host)]
+            if not writable:
+                self.before[guest] = inventory(host)
+        if problems:
+            raise HostLitter(_message(problems))
+
+    def after(self, seen: Iterable[str]) -> None:
+        if MODE == "off":
+            return
+        problems = [f"{name!r} handed to the guest by fd_readdir" for name in sorted(set(seen))]
+        for host, guest, writable in self.grants:
+            problems += [f"{_join(guest, rel)} (after the run)" for rel in litter_in(host)]
+            if not writable:
+                now = inventory(host)
+                old = self.before[guest]
+                problems += [f"{_join(guest, rel)} appeared during the run" for rel in now - old]
+                problems += [f"{_join(guest, rel)} vanished during the run" for rel in old - now]
+        if problems:
+            raise HostLitter(_message(sorted(set(problems))))
+
+
+def _join(guest: str, rel: str) -> str:
+    return guest.rstrip("/") + "/" + rel
+
+
+def _message(problems: list[str]) -> str:
+    shown = problems[:8] + ([f"and {len(problems) - 8} more"] if len(problems) > 8 else [])
+    return (
+        "a host process changed a folder the guest sees, so this run's outcome and fuel prove"
+        " nothing: " + "; ".join(shown) + " (litter such as .DS_Store comes from Finder or"
+        " System Settings' storage scan; see the spec on host litter)"
+    )
