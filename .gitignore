# Untrusted downloads (toolchains, source tarballs) and build trees: regenerated by scripts/00_download.sh
# and the build scripts. Only the hash list is tracked.
downloads/*
!downloads/SHA256SUMS
build/
.venv/
.venv-build/
__pycache__/
*.pyc

# Artifacts never live in git: they are release assets, and the wheel picks them up at build time.
*.wasm
*.cwasm
*.zip
*.tar.xz
*.tar.gz
src/wasi_python/artifacts/
dist/
.idea/

# Logs from the build scripts land in build/; keep any copied beside the research.
!context/research/**/*.log

# Prior art is studied in place and never committed; only its index is tracked.
context/prior_art/*
!context/prior_art/README.md

# What an operating system writes into folders a person browses (spec 090): never a source file.
# The Icon line ends in two carriage returns (git strips one), so it matches Finder's "Icon\r".
.DS_Store
._*
Icon

# The documentation site mkdocs builds; the workflow uploads it, git never holds it.
site/

# Secrets never live in git: environment files, keys and certificates, and the local Claude
# settings, which can hold tokens. A broad `git add` must not carry one in.
.env
.env.*
*.pem
*.key
.claude/settings.local.json
