# Meson cross file: numpy 2.5.2 -> wasm32-wasip1 as static archives (spec 003).
# Paths are rewritten by the build steps (the @ROOT@ token, replaced by the repository root, and @SDK@, by
# scripts/line.conf's WASI_SDK_DIR) so the file stays relocatable.
[binaries]
c = '@ROOT@/scripts/wasi-cc'
cpp = '@ROOT@/scripts/wasi-cxx'
ar = '@ROOT@/build/tools/@SDK@/bin/llvm-ar'
ranlib = '@ROOT@/build/tools/@SDK@/bin/llvm-ranlib'
strip = '@ROOT@/build/tools/@SDK@/bin/llvm-strip'
nm = '@ROOT@/build/tools/@SDK@/bin/llvm-nm'
python = '@ROOT@/scripts/python-wasi-cross'
cython = '@ROOT@/build/tools/pylib/bin/cython'
# numpy finds the set's OpenBLAS (step 38) through step 10's pinned pkgconf and OpenBLAS's own
# openblas.pc, which step 40 alone puts on the search path; no CMake method (spec 100, Decision 2).
pkg-config = '@ROOT@/build/tools/pylib/pkgconf/.bin/pkgconf'
cmake = '@ROOT@/build/no-cmake'

[host_machine]
system = 'wasi'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'

[properties]
# wasm32 `long double` is IEEE binary128 (sizeof == 16, fixtures/hello.c proved the size); numpy cannot run a probe binary.
longdouble_format = 'IEEE_QUAD_LE'
needs_exe_wrapper = true
skip_sanity_check = true

[built-in options]
# -ffile-prefix-map: no builder's path in __FILE__ strings, so the binary's hash does not depend on the checkout.
# npy_fenv_flags.h, in both lines (spec 099): wasm has no floating-point status flags, so it keeps the
# signals numpy raises itself (a failed LAPACK call, integer division by zero, float16 overflow) in
# one software flag word; C++ needs it for float_status.hpp's float16 raises.
c_args = ['-ffile-prefix-map=@ROOT@=/wasi-python-build', '-include', '@ROOT@/recipes/npy_rename.h', '-include', '@ROOT@/recipes/npy_random_legacy_rename.h', '-include', '@ROOT@/recipes/npy_fenv_flags.h', '-D_WASI_EMULATED_SIGNAL', '-D_WASI_EMULATED_PROCESS_CLOCKS', '-D_WASI_EMULATED_GETPID', '-DNPY_NO_SIGNAL', '-Wno-return-type']
# C++ exceptions in their standard form (wasi-sdk's CppExceptions.md, 33 and 34; spec 005, Decision 3).
cpp_args = ['-ffile-prefix-map=@ROOT@=/wasi-python-build', '-include', '@ROOT@/recipes/npy_fenv_flags.h', '-fwasm-exceptions', '-mllvm', '-wasm-use-legacy-eh=false', '-D_WASI_EMULATED_SIGNAL', '-D_WASI_EMULATED_PROCESS_CLOCKS', '-D_WASI_EMULATED_GETPID', '-DNPY_NO_SIGNAL', '-fexceptions', '-Wno-return-type']
# No link args: every extension module becomes an archive, and the one real link is python.wasm's own (Setup.local carries the libs).
