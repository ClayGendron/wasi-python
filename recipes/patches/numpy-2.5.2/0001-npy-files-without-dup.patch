+@pytest.mark.parametrize("arr", basic_arrays + record_arrays)
+def test_save_load_without_dup(tmp_path, monkeypatch, arr):
+    # WASI cannot duplicate a file descriptor, so `os.dup` raises there.
+    # Saving to and loading from a real file must not need it.
+    def dup(fd):
+        raise OSError(errno.ENOTSUP, "Not supported")
+
+    monkeypatch.setattr(sys, "platform", "wasi")
+    monkeypatch.setattr(os, "dup", dup)
+    path = tmp_path / "a.npy"
+    np.save(path, arr)
+    assert_array_equal(np.load(path, allow_pickle=True), arr)
+
