+@pytest.mark.parametrize("arr", basic_arrays + record_arrays)
+def test_save_load_without_dup(tmp_path, monkeypatch, arr):
+    # WASI cannot duplicate a file descriptor, so `os.dup` raises there.
+    # Saving to and loading from a real file must not need it.
+    def dup(fd):
+        raise OSError(errno.ENOTSUP, "Not supported")
+
+    monkeypatch.setattr(sys, "platform", "wasi")
+    monkeypatch.setattr(os, "dup", dup)
+    path = tmp_path / "a.npy"
+    np.save(path, arr)
+    assert_array_equal(np.load(path, allow_pickle=True), arr)
+
+
+def test_save_masked_without_dup(tmp_path, monkeypatch):
+    # On WASI a real file takes the chunked path, but a subclass's own
+    # `tofile` still decides: a masked array is refused, as elsewhere.
+    def dup(fd):
+        raise OSError(errno.ENOTSUP, "Not supported")
+
+    monkeypatch.setattr(sys, "platform", "wasi")
+    monkeypatch.setattr(os, "dup", dup)
+    xm = np.ma.masked_array([1, 2, 3], mask=[False, True, False])
+    with pytest.raises(NotImplementedError):
+        np.save(tmp_path / "a.npy", xm)
+    # A buffered BytesIO is not a real file: written in chunks, as elsewhere.
+    np.save(io.BufferedWriter(io.BytesIO()), xm)
+
