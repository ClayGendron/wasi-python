+def _dataset_file(name):
+    """
+    A gzipped file of package_data/datasets, decompressed as it is read.
+
+    The file is read through the package's loader, so it is found when plotly
+    is imported from a zip archive as well as from a folder.
+    """
+    data = pkgutil.get_data("plotly", "package_data/datasets/" + name)
+    return gzip.GzipFile(fileobj=io.BytesIO(data), mode="rb")
