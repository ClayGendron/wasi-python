#!/bin/sh
# The x86_64 Linux host's compiler (spec 040, Decision 5): the pinned arm64 Linux wasi-sdk's own
# clang, run under the pinned qemu-aarch64, so every host compiles with an arm64 build of the same
# clang. wasi-sdk's x86_64 clang orders two stack slots of one numpy function differently
# (context/research/2026-10-17-x86-64-rebuilds-differ-in-one-function.md); this file goes when an
# SDK's two builds agree (spec 040, Decision 9).
#
# Step 10 copies it into the arm64 SDK's bin/, beside the real clang: the driver takes its
# InstalledDir from argv[0], and the guest's loader finds libLLVM through the clang's RPATH,
# $ORIGIN/../lib. The native SDK's clang is a link to the copy, so `clang`, `clang++` and
# `clang-cpp` reach it by their own names.
#
# The emulated driver may run only two programs: this launcher again, for -cc1 and -cc1as, and the
# aarch64 tree's wasm-ld, which step 10 makes a redirect to the native linker. Anything else would
# be an aarch64 ELF, which this host cannot run.
set -eu
A=$(dirname "$(readlink -f "$0")")
T=$(dirname "$(dirname "$A")")
EMULATOR="$T/emulator/qemu-aarch64"
ROOT="$T/aarch64-root"
# The real clang is what the tree's own `clang` link leads to; a link that leads nowhere is named.
CLANG=$(readlink -f "$A/clang" 2> /dev/null) || CLANG="$A/clang"
for need in "$EMULATOR" "$ROOT" "$CLANG"; do
  [ -e "$need" ] || { echo "ERROR clang-emulated: $need is missing (scripts/steps/10_tools.sh)" >&2; exit 1; }
done

# Only the emulator reads QEMU_ variables, and they can change what the guest sees or does
# (QEMU_SET_ENV, QEMU_CPU, QEMU_STRACE...): none may reach it. The guest's loader is passed none of
# the host's loader variables (-U).
for name in $(env | sed -n 's/^\(QEMU_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$name"
done
run() {
  exec "$EMULATOR" -L "$ROOT" -U LD_PRELOAD -U LD_LIBRARY_PATH -U LD_AUDIT -0 "$A/clang-emulated" "$CLANG" "$@"
}

# The driver re-running itself: its own arguments, nothing added.
case "${1:-}" in
  -cc1|-cc1as) run "$@";;
esac

# A driver call: the driver sees argv[0] as .../clang-emulated, so the name this was called by sets
# its mode, exactly; any other name (clang-cl, a target-prefixed name) is refused, not run in the
# wrong mode. -no-canonical-prefixes keeps the driver's re-runs on this launcher, not the ELF.
case "$(basename "$0")" in
  clang) run -no-canonical-prefixes "$@";;
  clang++) run -no-canonical-prefixes --driver-mode=g++ "$@";;
  clang-cpp) run -no-canonical-prefixes --driver-mode=cpp "$@";;
  *) echo "ERROR clang-emulated: no driver mode for the name $(basename "$0")" >&2; exit 1;;
esac
